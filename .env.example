# --------------------------------------------------
# agentic_browser_v2 / .env.example
# --------------------------------------------------
# --- LLM (required) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- CRAG (required if you use answer_company_question) ---
GOOGLE_API_KEY=
TAVILY_API_KEY=
CRAG_ALLOW_WEB_SEARCH=false

# --- Meta Graph API (required for the Page) — see docs/GRAPH_API_SETUP.md ---
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- Meta Webhook (required to receive Instagram message events) ---
# Use the same long random value in the Meta dashboard's Verify Token field.
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_PORT=8000

# --- Optional: vision fallback (OmniParser via Replicate) ---
REPLICATE_API_TOKEN=
